<?xml version="1.0" encoding="utf-8"?>
<!-- 第一屏 HMI：连接状态 / 图传一键启停 / 遥测 / 电源 / 日志。
     2026-10 精简：去掉舵机转向、去掉 MJPEG 拉流（图传改为 Camera2 硬编推流，
     配置在第二屏设置并记忆，本屏只做一键启停）。 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#0B0E12">

    <!-- ══ 顶栏：标题 + 设置入口 + 连接状态 + 帧率 ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="狼牙视觉"
            android:textColor="#BD93F9"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBridge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="桥接/图传设置"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />

        <Button
            android:id="@+id/btnVisionSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="视觉设置"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />

        <Button
            android:id="@+id/btnLaser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="激光桥"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />

        <TextView
            android:id="@+id/tvConn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="○ 未连接"
            android:textColor="#FFFF00"
            android:textSize="14sp"
            android:padding="2dp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FPS 0.0"
            android:textColor="#8BE9FD"
            android:textSize="12sp"
            android:padding="4dp" />
    </LinearLayout>

    <!-- ══ 主区：左列(图传/遥测/电源) + 右列(日志) ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- ── 左列 ── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.6"
            android:orientation="vertical"
            android:paddingEnd="6dp">

            <!-- 相机预览 + 视觉检测叠加（图传运行时显示） -->
            <FrameLayout
                android:id="@+id/previewContainer"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:background="#000000"
                android:paddingBottom="4dp">

                <SurfaceView
                    android:id="@+id/svPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.robomaster.control.vision.VisionOverlayView
                    android:id="@+id/visionOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <!-- 图传一键启停 + CH343 状态 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="4dp">

                <Button
                    android:id="@+id/btnVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="图传启停"
                    android:textSize="13sp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp" />

                <Button
                    android:id="@+id/btnSwitchIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP:R1"
                    android:textSize="13sp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp" />

                <TextView
                    android:id="@+id/tvCh343"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CH343 检测中…"
                    android:textColor="#6272A4"
                    android:textSize="12sp"
                    android:paddingStart="8dp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- 传感器遥测 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="6dp">

                <TextView
                    android:id="@+id/tvUltrasonic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="超声 0mm"
                    android:textColor="#50FA7B"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvTof"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TOF 0mm"
                    android:textColor="#50FA7B"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvMag"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="地磁 0/0/0"
                    android:textColor="#50FA7B"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvLaser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="激光 0mm"
                    android:textColor="#50FA7B"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- 电源状态 + Type-C 开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp">

                <TextView
                    android:id="@+id/tvPower"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="V 0V  I 0mA  T 0℃"
                    android:textColor="#FFB86C"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <Button
                    android:id="@+id/btnTypec1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="C1 电源"
                    android:textSize="11sp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp" />

                <Button
                    android:id="@+id/btnTypec2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="C2 电源"
                    android:textSize="11sp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── 右列：日志 ── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.4"
            android:orientation="vertical"
            android:paddingStart="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="调试日志"
                android:textColor="#6272A4"
                android:textSize="12sp"
                android:paddingBottom="2dp" />

            <ScrollView
                android:id="@+id/scrollLog"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#0B0E12">

                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#6272A4"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:padding="4dp" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
